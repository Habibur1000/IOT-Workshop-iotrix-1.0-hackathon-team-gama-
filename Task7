#include <WiFi.h>
#include <WebServer.h>
#include "DHT.h"

#define WIFI_SSID "Fariha Lubaba"
#define WIFI_PASSWORD "12345678"

#define DHTPIN 4
#define DHTTYPE DHT11
#define WATER_SENSOR_PIN 34
const int WATER_THRESHOLD = 500;

DHT dht(DHTPIN, DHTTYPE);
WebServer server(80);

float temperature = 0.0;
float humidity = 0.0;
int rawWaterLevel = 0;
float waterPercentage = 0.0;
bool waterDetected = false;

